DATABASE_URL=mysql+pymysql://lunch_user:CHANGE_ME@127.0.0.1:3306/lunch_picker?charset=utf8mb4
# 서비스 도메인만 허용한다(쉼표로 여러 개). 개발 중에는 Vite 주소.
CORS_ORIGINS=http://localhost:5173
# Nginx 같은 신뢰하는 프록시 뒤에서만 true (로그인 시도 속도 제한이 X-Forwarded-For 의 첫 값을 접속자 IP 로 쓴다)
TRUST_PROXY=false
# 로그인 토큰 서명 키(긴 무작위 값). 만들기: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
